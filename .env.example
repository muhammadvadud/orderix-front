# ─────────────────────────────────────────────────────────────
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Loyiha rejimi: dev (hot reload) yoki prod (optimallashtirilgan)
#   dev  -> kod o'zgarsa darhol ko'rinadi, qayta build shart emas
#   prod -> tezkor, optimallashtirilgan standalone build
COMPOSE_PROFILES=dev

# Backend API manzili — loyihadagi barcha so'rovlar shu yerga boradi
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Host port (brauzerda http://localhost:<WEB_PORT>)
WEB_PORT=3000
